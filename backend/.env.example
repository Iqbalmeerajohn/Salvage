# Copy to backend/.env and fill in as you obtain keys. EVERYTHING here is optional:
# with no .env at all, SALVAGE runs fully offline in demo mode (mock LLM + mock
# gateway + SQLite). Add keys to upgrade individual layers to live — no code change.

# --- Google AI Studio (free) : upgrades diagnosis from mock -> real Gemini -----
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash

# --- Optional local model (e.g. Ollama) : middle fallback ---------------------
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3.2

# --- Razorpay TEST MODE (free) : upgrades gateway from mock -> real test links -
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Behaviour ---------------------------------------------------------------
# Require HMAC verification on inbound webhooks (set true once a secret is set):
# REQUIRE_WEBHOOK_SIGNATURE=false

# SQLite location (default: ../data/salvage.db):
# SALVAGE_DB=../data/salvage.db
