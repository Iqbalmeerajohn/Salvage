# Copy to backend/.env for local dev, or set these in the Vercel project's
# Environment Variables (Production). NOTHING here is required to run locally:
# with no .env at all, SALVAGE runs fully offline (mock LLM + mock gateway +
# SQLite). Each variable upgrades one layer to live, with no code change.

# --- Database ----------------------------------------------------------------
# Postgres (Supabase) takes priority whenever set; otherwise SQLite is used.
# IMPORTANT for Vercel: use the Supabase *Transaction pooler* string (port 6543).
# Supabase's DIRECT connection (db.<ref>.supabase.co:5432) is IPv6-only on the
# free tier and Vercel's runtime is IPv4-only, so the direct URL is unreachable
# from a Vercel function. The pooler is IPv4 on every tier.
#   Supabase Dashboard -> Connect -> Connection string -> Transaction pooler
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
#
# The Supabase<>Vercel integration's own variable names are also accepted
# automatically, in this order: DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL,
# POSTGRES_URL_NON_POOLING.
#
# Local SQLite override (default: ../data/salvage.db; /tmp/salvage.db on Vercel):
# SALVAGE_DB=../data/salvage.db

# --- Google AI Studio (free) : upgrades diagnosis from mock -> real Gemini -----
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-3.5-flash

# --- Optional local model (e.g. Ollama) : middle fallback ---------------------
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3.2

# --- Razorpay TEST MODE : upgrades gateway from mock -> real test-mode links ---
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# REQUIRE_WEBHOOK_SIGNATURE=false   # set true once a webhook secret is configured

# Optional budget for REAL test-mode Payment Links (test accounts have a small
# quota). This is configuration, never a constant in code. 0 or unset = no cap.
# Only enforced when the real Razorpay gateway is active.
# RAZORPAY_MAX_TEST_LINKS=10

# --- Worker ------------------------------------------------------------------
# Drain the outbox in-process (single-service cloud deploys):
# RUN_WORKER=true
